.0,"text":"So it's a dream come true.","words":[[145.1,145.22,"So"],[145.22,145.94,"it's"],[145.94,146.46,"a"],[146.46,146.6,"dream"],[146.6,146.78,"come"],[146.78,147.0,"true."]]},{"start":147.14,"end":151.42,"text":"I know that I've said that several times during this year, after my first win, after my second win","words":[[147.14,147.22,"I"],[147.22,147.36,"know"],[147.36,147.5,"that"],[147.5,147.76,"I've"],[147.76,148.02,"said"],[148.02,148.26,"that"],[148.26,148.54,"several"],[148.54,148.88,"times"],[148.88,149.12,"during"],[149.12,149.32,"this"],[149.32,149.54,"year,"],[149.68,149.8,"after"],[149.8,149.98,"my"],[149.98,150.22,"first"],[150.22,150.44,"win,"],[150.64,150.7,"after"],[150.7,150.9,"my"],[150.9,151.1,"second"],[151.1,151.42,"win"]]},{"start":151.42,"end":154.18,"text":"and now after winning the championship but that's how I feel.","words":[[151.42,151.84,"and"],[151.84,152.1,"now"],[152.1,152.4,"after"],[152.4,152.56,"winning"],[152.56,152.74,"the"],[152.74,153.0,"championship"],[153.0,153.36,"but"],[153.36,153.7,"that's"],[153.7,153.84,"how"],[153.84,153.98,"I"],[153.98,154.18,"feel."]]},{"start":154.46,"end":157.98,"text":"That's my true emotions I've got inside of me.","words":[[154.46,154.54,"That's"],[154.54,154.82,"my"],[154.82,156.14,"true"],[156.14,156.6,"emotions"],[156.6,157.04,"I've"],[157.04,157.16,"got"],[157.16,157.46,"inside"],[157.46,157.64,"of"],[157.64,157.98,"me."]]},{"start":159.14,"end":162.68,"text":"I'm simply speechless. I don't know how to describe what I'm feeling right now.","words":[[159.14,159.58,"I'm"],[159.58,160.02,"simply"],[160.02,160.68,"speechless."],[160.86,160.88,"I"],[160.88,161.0,"don't"],[161.0,161.14,"know"],[161.14,161.28,"how"],[161.28,161.42,"to"],[161.42,161.74,"describe"],[161.74,161.94,"what"],[161.94,162.1,"I'm"],[162.1,162.26,"feeling"],[162.26,162.44,"right"],[162.44,162.68,"now."]]},{"start":162.86,"end":166.06,"text":"It feels like...","words":[[162.86,162.86,"It"],[162.86,165.46,"feels"],[165.46,